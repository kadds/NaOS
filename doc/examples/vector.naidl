library naos_test;

protocol Vector @uuid("321c5538-f15c-41e3-bc4b-4080e41f63b6") @revision(1) @features(0) @experimental {
    method values @id(1) {
        vector<u32, 8> items @id(1);
    } -> {
        vector<u32, 8> items @id(1);
    };
    method inline_values @id(2) {
        vector<u32, 8> items @id(1) @inline;
    } -> {
        vector<u32, 8> items @id(1) @inline;
    };
    method matrix @id(3) {
        array<array<u16, 2>, 2> items @id(1);
    } -> {
        array<array<u16, 2>, 2> items @id(1);
    };
};
