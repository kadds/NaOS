library naos_test;

struct ResourcePair {
    handle<stream, transfer+duplicate, duplicate> first @id(1);
    handle<stream, transfer, move> second @id(2);
};

protocol Resources @uuid("d8bfeaf9-b3c2-41b6-bdbd-7aa228262128") @revision(1) @features(0) @experimental {
    method pass @id(1) {
        vector<handle<stream, transfer, move>, 4> values @id(1);
        ResourcePair pair @id(2);
    } -> {
        vector<handle<stream, transfer, duplicate>, 4> values @id(1);
        ResourcePair pair @id(2);
    };
};
