{% macro metadata_checks(type_, expression, indent) %}
{% if type_.kind in resource_kinds %}
{{ indent }}if (!validate_resource(context, handles[{{ expression }}.value], {{ bindings[type_.kind] }}, {{ scope(type_.scope) or "0" }}, {{ rights(type_.rights) or "0" }})) {
{{ indent }}    naoidl::close_resource_batch(handles, resource_count, close_resource, context);
{{ indent }}    return false;
{{ indent }}}
{% elif type_.kind == "array" %}
{{ indent }}for (std::uint32_t i = 0; i < {{ type_.bound }}; ++i) {
{{ metadata_checks(type_.element, expression ~ "[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind == "vector" %}
{{ indent }}for (std::uint32_t i = 0; i < {{ expression }}.count; ++i) {
{{ metadata_checks(type_.element, expression ~ ".data[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind in named_structs %}
{% for nested in named_structs[type_.kind].fields|sort(attribute="id") %}{{ metadata_checks(nested.type, expression ~ "." ~ cpp_name(nested.name), indent) }}{% endfor %}
{% endif %}
{% endmacro %}

inline bool validate_{{ name }}_resource_metadata(const {{ name }} &value, const na_handle_t *handles,
                                                  std::uint64_t resource_count, naoidl::resource_metadata_validator validate_resource,
                                                  naoidl::resource_closer close_resource, void *context) {
    if (!validate_{{ name }}_resources(value, resource_count)) {
        naoidl::close_resource_batch(handles, resource_count, close_resource, context);
        return false;
    }
    if (resource_count != 0 && (handles == nullptr || validate_resource == nullptr || close_resource == nullptr)) {
        naoidl::close_resource_batch(handles, resource_count, close_resource, context);
        return false;
    }
{%- if has_resources %}
{%- for field in fields|sort(attribute="id") %}{{ metadata_checks(field.type, "value." ~ cpp_name(field.name), "    ") }}{% endfor %}
{%- endif %}
    return true;
}
