{% macro disposition_checks(type_, expression, indent) %}
{% if type_.kind in resource_kinds %}
{{ indent }}if ({{ expression }}.value >= resource_count) return false;
{{ indent }}if (resources[{{ expression }}.value].flags != 0 || resources[{{ expression }}.value].operation != {{ "NA_RESOURCE_DUPLICATE" if type_.ownership == "duplicate" else "NA_RESOURCE_MOVE" }}) return false;
{% if rights(type_.rights) %}{{ indent }}if (resources[{{ expression }}.value].rights != 0 && (resources[{{ expression }}.value].rights & ({{ rights(type_.rights) }})) != ({{ rights(type_.rights) }})) return false;
{% endif %}{% if scope(type_.scope) %}{{ indent }}if (resources[{{ expression }}.value].scope != {{ scope(type_.scope) }}) return false;
{% endif %}{% elif type_.kind == "array" and type_has_resources(type_) %}
{{ indent }}for (std::uint32_t i = 0; i < {{ type_.bound }}; ++i) {
{{ disposition_checks(type_.element, expression ~ "[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind == "vector" and type_has_resources(type_) %}
{{ indent }}if ({{ expression }}.count > {{ type_.bound }} || ({{ expression }}.count != 0 && {{ expression }}.data == nullptr)) return false;
{{ indent }}for (std::uint32_t i = 0; i < {{ expression }}.count; ++i) {
{{ disposition_checks(type_.element, expression ~ ".data[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind in named_structs and type_has_resources(type_) %}
{% for nested in named_structs[type_.kind].fields|sort(attribute="id") %}{{ disposition_checks(nested.type, expression ~ "." ~ cpp_name(nested.name), indent) }}{% endfor %}
{% endif %}
{% endmacro %}

{% if has_resources %}
inline bool validate_{{ name }}_dispositions(const {{ name }} &value, const na_resource_disposition_t *resources, std::uint64_t resource_count) {
    if (resource_count > NA_CHANNEL_MAX_RESOURCES || (resource_count != 0 && resources == nullptr)) return false;
{% for field in fields|sort(attribute="id") %}{{ disposition_checks(field.type, "value." ~ cpp_name(field.name), "    ") }}{% endfor %}    return true;
}
{% else %}
inline bool validate_{{ name }}_dispositions(const {{ name }} &, const na_resource_disposition_t *, std::uint64_t resource_count) { return resource_count == 0; }
{% endif %}
