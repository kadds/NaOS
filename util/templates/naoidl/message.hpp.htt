{% import "type_codec.htt" as codec %}
{% macro payload_size(type_, expression) %}
{% if type_.kind in ("bytes", "string") %}static_cast<std::uint64_t>({{ expression }}.size){% elif type_.kind == "vector" and type_size(type_.element, named_sizes) is not none %}static_cast<std::uint64_t>({{ expression }}.count) * {{ type_size(type_.element, named_sizes) }}{% else %}{{ cpp_name(type_.kind) }}_encoded_size({{ expression }}){% endif %}
{% endmacro %}
{% macro payload_encode(field, expression, indent) %}
{% if field.type.kind in ("bytes", "string") %}
{{ indent }}writer.put_bytes({{ expression }}.data, {{ expression }}.size);
{% elif field.type.kind == "vector" %}
{{ indent }}for (std::uint32_t i = 0; i < {{ expression }}.count; ++i) {
{{ codec.encode(field.type.element, expression ~ ".data[i]", "writer", indent ~ "    ", resource_kinds, cpp_name) }}{{ indent }}}
{% else %}
{{ indent }}{{ cpp_name(field.type.kind) }}_encode(writer, {{ expression }});
{% endif %}
{% endmacro %}

{% macro payload_decode(field, expression, offset, count, storage, indent) %}
{{ indent }}if ({{ offset }} < {{ message.header_size }} || {{ offset }} > size || {{ count }} > {{ field.type.bound or 0 }}) return false;
{% if field.type.kind in ("bytes", "string") %}
{% if not field.count_is_remainder %}{{ indent }}if ({{ count }} > size - {{ offset }}) return false;
{% endif %}{{ indent }}{{ expression }}.data = reinterpret_cast<const {{ "char" if field.type.kind == "string" else "std::uint8_t" }} *>(buffer + {{ offset }});
{{ indent }}{{ expression }}.size = static_cast<std::uint32_t>({{ count }});
{% elif field.type.kind == "vector" %}
{{ indent }}if ({{ count }} > (size - {{ offset }}) / {{ field.element_size }}) return false;
{% if storage %}{{ indent }}{
{{ indent }}    std::uint64_t vector_bytes = 0;
{{ indent }}    if (!naoidl::checked_mul({{ count }}, {{ field.element_size }}, vector_bytes) || vector_bytes > size - {{ offset }}) return false;
{{ indent }}    {{ expression }}.data = {{ storage }}.data();
{{ indent }}    {{ expression }}.count = static_cast<std::uint32_t>({{ count }});
{{ indent }}    naos::canonical::reader vector_reader(buffer + {{ offset }}, vector_bytes);
{{ indent }}    for (std::uint32_t i = 0; i < {{ expression }}.count; ++i) {
{{ codec.decode(field.type.element, expression ~ ".data[i]", "vector_reader", indent ~ "        ", resource_kinds, cpp_name) }}{{ indent }}    }
{{ indent }}    if (!vector_reader.good() || vector_reader.remaining() != 0) return false;
{{ indent }}}
{% else %}{{ indent }}return false; // vector decoder requires generated storage
{% endif %}
{% else %}
{{ indent }}return false;
{% endif %}
{% endmacro %}

struct {{ message.name }} {
{% for field in message.fields %}
    {{ codec.cpp_type(field.type) }} {{ field.cpp_name }}{};
{% if field.type.kind == "vector" %}
    std::array<{{ codec.cpp_type(field.type.element) }}, {{ field.type.bound }}> {{ field.cpp_name }}_storage{};
{% endif %}
{% endfor %}
};
inline constexpr std::uint64_t {{ message.name }}_header_bytes = {{ message.header_size }};
inline bool encode_{{ message.name }}(std::uint8_t *buffer, std::uint64_t capacity, const {{ message.name }} &value, std::uint64_t &written) {
{% if not message.fields %}    (void)value;
{% endif %}    std::uint64_t dynamic_size = 0;
{% for field in message.dynamic_fields %}    if (!naoidl::checked_add(dynamic_size, {{ payload_size(field.type, "value." ~ field.cpp_name) }}, dynamic_size)) return false;
    if (value.{{ field.cpp_name }}.{{ field.count_member }} > {{ field.type.bound }}) return false;
{% if field.length_field %}    if (value.{{ field.cpp_name }}.{{ field.count_member }} != value.{{ field.length_field }}) return false;
{% endif %}{% endfor %}    if (!naoidl::checked_add({{ message.name }}_header_bytes, dynamic_size, written) || written > capacity || (written != 0 && buffer == nullptr)) return false;
    if (written == 0) return true;
    naos::canonical::writer writer(buffer, capacity);
{% for field in message.fields %}{% if field.is_descriptor %}    writer.put_u32(static_cast<std::uint32_t>({{ message.name }}_header_bytes + {{ field.descriptor_index }}));
    writer.put_u32(value.{{ field.cpp_name }}.{{ field.count_member }});
{% elif not field.is_dynamic %}{{ codec.encode(field.type, "value." ~ field.cpp_name, "writer", "    ", resource_kinds, cpp_name) }}{% endif %}{% endfor %}{% for field in message.dynamic_fields %}{{ payload_encode(field, "value." ~ field.cpp_name, "    ") }}{% endfor %}    return writer.good() && writer.size() == written;
}
inline bool decode_{{ message.name }}(const std::uint8_t *buffer, std::uint64_t size, {{ message.name }} &value) {
{% if not message.fields %}    (void)value;
{% endif %}    if (size < {{ message.name }}_header_bytes || (size != 0 && buffer == nullptr)) return false;
    if (size == 0) return true;
    naos::canonical::reader reader(buffer, size);
{% if message.descriptor_fields %}    struct dynamic_descriptor { std::uint64_t offset; std::uint64_t count; };
    dynamic_descriptor dynamic[{{ message.descriptor_fields|length }}]{};
{% endif %}{% for field in message.fields %}{% if field.is_descriptor %}    dynamic[{{ field.descriptor_index }}].offset = reader.get_u32();
    dynamic[{{ field.descriptor_index }}].count = reader.get_u32();
{% elif not field.is_inline %}{{ codec.decode(field.type, "value." ~ field.cpp_name, "reader", "    ", resource_kinds, cpp_name) }}{% endif %}{% endfor %}    if (!reader.good() || reader.offset() != {{ message.name }}_header_bytes) return false;
    std::uint64_t cursor = {{ message.name }}_header_bytes;
{% for field in message.dynamic_fields %}{% if field.is_descriptor %}    if (dynamic[{{ field.descriptor_index }}].offset != cursor) return false;
{% set offset = "dynamic[" ~ field.descriptor_index ~ "].offset" %}{% set count = "dynamic[" ~ field.descriptor_index ~ "].count" %}{% else %}{% set offset = "cursor" %}{% set count = "value." ~ field.length_field if field.length_field else "size - cursor" %}{% endif %}{{ payload_decode(field, "value." ~ field.cpp_name, offset, count, "value." ~ field.cpp_name ~ "_storage" if field.type.kind == "vector" else "", "    ") }}{% if field.type.kind in ("bytes", "string") %}    if (!naoidl::checked_add({{ offset }}, {{ count }}, cursor)) return false;
{% elif field.type.kind == "vector" %}    std::uint64_t payload_bytes_{{ field.payload_index }} = 0;
    if (!naoidl::checked_mul({{ count }}, {{ field.element_size }}, payload_bytes_{{ field.payload_index }}) || !naoidl::checked_add({{ offset }}, payload_bytes_{{ field.payload_index }}, cursor)) return false;
{% endif %}{% endfor %}    return cursor == size;
}
