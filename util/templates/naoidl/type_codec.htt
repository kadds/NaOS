{% macro cpp_type(type_) -%}
{%- if type_.kind == "u8" -%}std::uint8_t
{%- elif type_.kind == "u16" -%}std::uint16_t
{%- elif type_.kind == "u32" -%}std::uint32_t
{%- elif type_.kind == "u64" -%}std::uint64_t
{%- elif type_.kind == "i8" -%}std::int8_t
{%- elif type_.kind == "i16" -%}std::int16_t
{%- elif type_.kind == "i32" -%}std::int32_t
{%- elif type_.kind == "i64" -%}std::int64_t
{%- elif type_.kind == "f32" -%}float
{%- elif type_.kind == "f64" -%}double
{%- elif type_.kind == "bytes" -%}naoidl::bounded_bytes
{%- elif type_.kind == "string" -%}naoidl::bounded_string
{%- elif type_.kind == "vector" -%}naoidl::bounded_vector<{{ cpp_type(type_.element) }}>
{%- elif type_.kind == "array" -%}std::array<{{ cpp_type(type_.element) }}, {{ type_.bound }}>
{%- elif type_.kind in ("handle", "client_end", "server_end") -%}naoidl::resource_index
{%- else -%}{{ type_.kind }}
{%- endif -%}
{%- endmacro %}

{% macro encode(type_, expression, writer, indent, resource_kinds, cpp_name) %}
{% if type_.kind in ("u8", "u16", "u32", "u64") %}
{{ indent }}{{ writer }}.put_{{ type_.kind }}({{ expression }});
{% elif type_.kind in ("i8", "i16", "i32", "i64") %}
{{ indent }}{{ writer }}.put_u{{ type_.kind[1:] }}(static_cast<std::uint{{ type_.kind[1:] }}_t>({{ expression }}));
{% elif type_.kind == "f32" %}
{{ indent }}naoidl::put_f32({{ writer }}, {{ expression }});
{% elif type_.kind == "f64" %}
{{ indent }}naoidl::put_f64({{ writer }}, {{ expression }});
{% elif type_.kind in resource_kinds %}
{{ indent }}{{ writer }}.put_u32({{ expression }}.value);
{% elif type_.kind == "array" %}
{{ indent }}for (std::uint32_t i = 0; i < {{ type_.bound }}; ++i) {
{{ encode(type_.element, expression ~ "[i]", writer, indent ~ "    ", resource_kinds, cpp_name) }}{{ indent }}}
{% else %}
{{ indent }}{{ cpp_name(type_.kind) }}_encode({{ writer }}, {{ expression }});
{% endif %}
{% endmacro %}

{% macro decode(type_, expression, reader, indent, resource_kinds, cpp_name) %}
{% if type_.kind in ("u8", "u16", "u32", "u64") %}
{{ indent }}{{ expression }} = {{ reader }}.get_{{ type_.kind }}();
{% elif type_.kind in ("i8", "i16", "i32", "i64") %}
{{ indent }}{{ expression }} = static_cast<std::int{{ type_.kind[1:] }}_t>({{ reader }}.get_u{{ type_.kind[1:] }}());
{% elif type_.kind == "f32" %}
{{ indent }}{{ expression }} = naoidl::get_f32({{ reader }});
{% elif type_.kind == "f64" %}
{{ indent }}{{ expression }} = naoidl::get_f64({{ reader }});
{% elif type_.kind in resource_kinds %}
{{ indent }}{{ expression }}.value = {{ reader }}.get_u32();
{% elif type_.kind == "array" %}
{{ indent }}for (std::uint32_t i = 0; i < {{ type_.bound }}; ++i) {
{{ decode(type_.element, expression ~ "[i]", reader, indent ~ "    ", resource_kinds, cpp_name) }}{{ indent }}}
{% else %}
{{ indent }}if (!{{ cpp_name(type_.kind) }}_decode({{ reader }}, {{ expression }})) return false;
{% endif %}
{% endmacro %}
