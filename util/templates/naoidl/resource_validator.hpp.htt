{% macro resource_checks(type_, expression, indent) %}
{% if type_.kind in resource_kinds %}
{{ indent }}if ({{ expression }}.value >= resource_count || seen[{{ expression }}.value]) return false;
{{ indent }}seen[{{ expression }}.value] = true;
{% elif type_.kind == "array" and type_has_resources(type_) %}
{{ indent }}for (std::uint32_t i = 0; i < {{ type_.bound }}; ++i) {
{{ resource_checks(type_.element, expression ~ "[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind == "vector" and type_has_resources(type_) %}
{{ indent }}if ({{ expression }}.count > {{ type_.bound }} || ({{ expression }}.count != 0 && {{ expression }}.data == nullptr)) return false;
{{ indent }}for (std::uint32_t i = 0; i < {{ expression }}.count; ++i) {
{{ resource_checks(type_.element, expression ~ ".data[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind in named_structs and type_has_resources(type_) %}
{% for nested in named_structs[type_.kind].fields|sort(attribute="id") %}{{ resource_checks(nested.type, expression ~ "." ~ cpp_name(nested.name), indent) }}{% endfor %}
{% endif %}
{% endmacro %}

{% macro resource_count_checks(type_, expression, indent) %}
{% if type_.kind in resource_kinds %}
{{ indent }}if (!naoidl::checked_add(expected_resources, 1, expected_resources)) return false;
{% elif type_.kind == "array" and type_has_resources(type_) %}
{{ indent }}for (std::uint32_t i = 0; i < {{ type_.bound }}; ++i) {
{{ resource_count_checks(type_.element, expression ~ "[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind == "vector" and type_has_resources(type_) %}
{{ indent }}if ({{ expression }}.count > {{ type_.bound }} || ({{ expression }}.count != 0 && {{ expression }}.data == nullptr)) return false;
{{ indent }}for (std::uint32_t i = 0; i < {{ expression }}.count; ++i) {
{{ resource_count_checks(type_.element, expression ~ ".data[i]", indent ~ "    ") }}{{ indent }}}
{% elif type_.kind in named_structs and type_has_resources(type_) %}
{% for nested in named_structs[type_.kind].fields|sort(attribute="id") %}{{ resource_count_checks(nested.type, expression ~ "." ~ cpp_name(nested.name), indent) }}{% endfor %}
{% endif %}
{% endmacro %}

{% if has_resources %}
inline bool validate_{{ name }}_resources(const {{ name }} &value, std::uint64_t resource_count) {
    if (resource_count > NA_CHANNEL_MAX_RESOURCES) return false;
    std::array<bool, NA_CHANNEL_MAX_RESOURCES> seen{};
{% for field in fields|sort(attribute="id") %}{{ resource_checks(field.type, "value." ~ cpp_name(field.name), "    ") }}{% endfor %}    std::uint64_t expected_resources = 0;
{% for field in fields|sort(attribute="id") %}{{ resource_count_checks(field.type, "value." ~ cpp_name(field.name), "    ") }}{% endfor %}    return expected_resources == resource_count;
}
{% else %}
inline bool validate_{{ name }}_resources(const {{ name }} &, std::uint64_t resource_count) { return resource_count == 0; }
{% endif %}
