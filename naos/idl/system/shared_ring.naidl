library naos.system;

protocol SharedRing @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a1008") @revision(1) @features(0) @scope(8) @uapi_name("SHARED_RING") {
    method get_info @id(1) -> {
        u64 slots @id(1);
        u64 slot_bytes @id(2);
        u64 queued @id(3);
    };
    method push @id(2) @max_bytes(65536) {
        u64 size @id(1);
        bytes<65536> data @id(2) @inline @length_field("size");
    } ->;
    method pop @id(3) @max_bytes(65536) {
        u64 capacity @id(1);
    } -> {
        u64 required_bytes @id(1);
        bytes<65536> data @id(2) @inline;
    };
};
