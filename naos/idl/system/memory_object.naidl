library naos.system;

protocol MemoryObject @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a1007") @revision(1) @features(0) @scope(7) @uapi_name("MEMORY_OBJECT") {
    method get_info @id(1) -> {
        u64 flags @id(1);
        u64 size @id(2);
        u64 max_size @id(3);
    };
    method read @id(2) @max_bytes(65536) {
        u64 offset @id(1);
        u64 size @id(2);
    } -> {
        bytes<65536> data @id(1) @inline;
    };
    method write @id(3) @max_bytes(65536) {
        u64 offset @id(1);
        u64 size @id(2);
        bytes<65536> data @id(3) @inline @length_field("size");
    } -> {
        u64 count @id(1);
    };
};
