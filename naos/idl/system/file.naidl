library naos.system;

struct Stat {
    u64 device @id(1);
    u64 inode @id(2);
    u64 links @id(3);
    u32 mode @id(4);
    u32 uid @id(5);
    u32 gid @id(6);
    u32 padding @id(7);
    u64 device_id @id(8);
    i64 size @id(9);
    i64 block_size @id(10);
    i64 blocks @id(11);
    i64 access_seconds @id(12);
    i64 access_nanoseconds @id(13);
    i64 modify_seconds @id(14);
    i64 modify_nanoseconds @id(15);
    i64 change_seconds @id(16);
    i64 change_nanoseconds @id(17);
    i64 unused0 @id(18);
    i64 unused1 @id(19);
    i64 unused2 @id(20);
};

protocol File @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a1002") @revision(1) @features(0) @scope(2) @uapi_name("FILE") {
    method pread @id(16) @max_bytes(65536) {
        i64 offset @id(1);
        u64 size @id(2);
        u64 flags @id(3);
    } -> {
        bytes<65536> data @id(1) @inline;
    };
    method pwrite @id(17) @max_bytes(65536) {
        i64 offset @id(1);
        u64 size @id(2);
        u64 flags @id(3);
        bytes<65536> data @id(4) @inline @length_field("size");
    } -> {
        u64 count @id(1);
    };
    method seek @id(18) {
        i64 offset @id(1);
        u64 whence @id(2);
    } -> {
        i64 offset @id(1);
    };
    method stat @id(19) -> {
        Stat value @id(1);
    };
    method sync @id(20) ->;
    method truncate @id(21) {
        u64 length @id(1);
    } ->;
    method allocate @id(22) {
        u64 offset @id(1);
        u64 length @id(2);
    } ->;
    method get_flags @id(23) -> {
        u64 flags @id(1);
    };
    method set_flags @id(24) {
        u64 flags @id(1);
    } ->;
};
